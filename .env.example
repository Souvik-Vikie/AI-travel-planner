# ---------- LLM (all free) ----------
# auto        -> use HuggingFace endpoint if HF token is set, else rule-based fallback
# hf_endpoint -> HuggingFace serverless Inference (free tier, needs HUGGINGFACEHUB_API_TOKEN)
# hf_local    -> run a small model on your own machine with transformers (pip install transformers torch)
# none        -> no LLM, deterministic templates (fastest, used by eval/tests)
LLM_BACKEND=auto
HUGGINGFACEHUB_API_TOKEN=
HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
HF_LOCAL_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct

# ---------- Travel data providers (leave empty to use offline mocks) ----------
# Duffel test-mode token (starts with duffel_test_) -> real search + real sandbox booking, no money
DUFFEL_API_TOKEN=
# SerpAPI free plan (100 searches/month) -> real Google Flights / Google Hotels prices
SERPAPI_API_KEY=
# Open-Meteo needs no key. Set to 0 to skip network weather lookups.
USE_OPEN_METEO=1

# ---------- Agent behaviour ----------
FLEX_DAYS=2                # search departure +/- N days
FLEX_MIN_SAVING=0.08       # only shift dates if flights get >= 8% cheaper
MAX_REPLANS=4              # budget critic re-plan limit
MOCK_SOLD_OUT_RATE=0.15    # chance a mock flight is "sold out" at booking time
